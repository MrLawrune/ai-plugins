        "url": "./plugins/parakeet-stt/assets/icon.svg"
      },
      "tags": [
        "voice",
        "stt",
        "dictation",
        "accessibility"
      ],
      "author": {
        "name": "MrLawrune",
        "github": "MrLawrune"
      },
      "source": {
        "git": {
          "url": "https://github.com/MrLawrune/ai-plugins.git",
          "subdir": "plugins/parakeet-stt",
          "range": "^0.1.0",
          "tagPrefix": "parakeet-stt/"
