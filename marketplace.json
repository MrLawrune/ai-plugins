      },
      "tags": [
        "voice",
        "tts",
        "accessibility"
      ],
      "author": {
        "name": "MrLawrune",
        "github": "MrLawrune"
      },
      "source": {
        "git": {
          "url": "https://github.com/MrLawrune/ai-plugins.git",
          "subdir": "plugins/kokoro-tts",
          "range": "^0.1.0",
          "tagPrefix": "kokoro-tts/"
        }
      }
    },
    {
      "id": "parakeet-stt",
      "displayName": "Parakeet STT",
      "description": "Dictate to your agents: Handy-style speech-to-text for every BB composer, powered by your own Parakeet server.",
