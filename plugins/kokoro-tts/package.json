{
  "name": "bb-plugin-kokoro-tts",
  "version": "0.3.4",
  "type": "module",
  "engines": {
    "bb": ">=0.43",
    "bbPluginSdk": ">=0.5.9"
  },
  "bb": {
    "name": "Kokoro TTS",
    "description": "Hear your agents: local Kokoro text-to-speech for every BB thread, set up and run for you.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./bb/server.ts",
    "app": "./bb/app.tsx"
  },
  "scripts": {
    "test": "npm run test:node && npm run test:ui",
    "test:node": "node --test \"bb/**/*.test.ts\"",
    "test:ui": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.9",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.2"
  },
  "description": "BB panel for the Kokoro TTS server"
}
